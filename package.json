{
  "name": "azota_cheat",
  "module": "index.js",
  "type": "module",
  "author": {
    "name": "kumiyui",
    "url": "https://github.com/kumiyuki"
  },
  "kumiyui": {
    "headers": {
      "name": "azota_cheat",
      "version": "2.2.6",
      "namespace": "https://github.com/kumiyuki/azota_cheat/",
      "description": "cheat for azota.vn platform",
      "author": "kumiyuki",
      "include": ["/^https?:\\/\\/azota\\.vn\\/.*\\/de-thi\\/.*$/", "/^https?:\\/\\/azota\\.vn\\/.*\\/test\\/(take-test|take-training)\\/.*$/"],
      "icon": "https://www.google.com/s2/favicons?sz=64&domain=azota.vn",
      "license": "GPL-3.0",
      "grant": [
        "GM_setValue",
        "GM_getValue",
        "GM_registerMenuCommand",
        "GM_unregisterMenuCommand"
      ],
      "run-at": "document-start",
      "downloadURL": "https://raw.githubusercontent.com/kumiyuki/azota_cheat/refs/heads/main/dist/azota_cheat.user.js",
      "updateURL": "https://raw.githubusercontent.com/kumiyuki/azota_cheat/refs/heads/main/dist/azota_cheat.user.js"
    },
    "entry": "./index.js",
    "output": "./dist/azota_cheat.user.js",
    "minified_output_path": "./dist/azota_cheat.min.user.js"
  },
  "scripts": {
    "build": "bun kumiyui build --both --bundle-kumiyui",
    "build-minify": "bun kumiyui build --minify",
    "build-no-minify": "bun kumiyui build"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "dependencies": {
    "kumiyui": "github:kumiyuki/kumiyui#v2.0.6"
  }
}
